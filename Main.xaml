                            <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Required namespaces: System.Drawing, System.Drawing.Imaging, System.IO&#xA;Dim srcPath As String = in_filepath&#xA;If Not System.IO.File.Exists(srcPath) Then&#xA;    out_filepath = String.Empty&#xA;    Return&#xA;End If&#xA;&#xA;' Ensure temp folder exists&#xA;If Not System.IO.Directory.Exists(temp_folder) Then&#xA;    System.IO.Directory.CreateDirectory(temp_folder)&#xA;End If&#xA;&#xA;Dim outPath As String = System.IO.Path.Combine(temp_folder, System.IO.Path.GetFileNameWithoutExtension(srcPath) &amp; &quot;_pre.png&quot;)&#xA;&#xA;' Load image&#xA;Dim bmpOrig As System.Drawing.Bitmap = CType(System.Drawing.Bitmap.FromFile(srcPath), System.Drawing.Bitmap)&#xA;&#xA;' Step 1: Convert to grayscale&#xA;Dim bmpGray As New System.Drawing.Bitmap(bmpOrig.Width, bmpOrig.Height, System.Drawing.Imaging.PixelFormat.Format24bppRgb)&#xA;For y As Integer = 0 To bmpOrig.Height - 1&#xA;    For x As Integer = 0 To bmpOrig.Width - 1&#xA;        Dim c As System.Drawing.Color = bmpOrig.GetPixel(x, y)&#xA;        ' standard luminance&#xA;        Dim g As Integer = CInt(0.299 * c.R + 0.587 * c.G + 0.114 * c.B)&#xA;        If g &lt; 0 Then g = 0 Else If g &gt; 255 Then g = 255&#xA;        bmpGray.SetPixel(x, y, System.Drawing.Color.FromArgb(g, g, g))&#xA;    Next&#xA;Next&#xA;bmpOrig.Dispose()&#xA;&#xA;' Step 2: Resize (upsample) - makes Tesseract more accurate on small text&#xA;Dim newW As Integer = CInt(Math.Max(1, Math.Round(bmpGray.Width * resizeFactor)))&#xA;Dim newH As Integer = CInt(Math.Max(1, Math.Round(bmpGray.Height * resizeFactor)))&#xA;Dim bmpResized As New System.Drawing.Bitmap(newW, newH)&#xA;Using g As System.Drawing.Graphics = System.Drawing.Graphics.FromImage(bmpResized)&#xA;    g.InterpolationMode = Drawing.Drawing2D.InterpolationMode.HighQualityBicubic&#xA;    g.DrawImage(bmpGray, 0, 0, newW, newH)&#xA;End Using&#xA;bmpGray.Dispose()&#xA;&#xA;' Step 3: Contrast adjustment (linear stretch around midpoint)&#xA;For y As Integer = 0 To bmpResized.Height - 1&#xA;    For x As Integer = 0 To bmpResized.Width - 1&#xA;        Dim c As System.Drawing.Color = bmpResized.GetPixel(x, y)&#xA;        Dim v As Integer = c.R&#xA;        Dim v2 As Integer = CInt((v - 128) * contrast + 128)&#xA;        If v2 &lt; 0 Then v2 = 0 Else if v2 &gt; 255 Then v2 = 255&#xA;        bmpResized.SetPixel(x, y, System.Drawing.Color.FromArgb(v2, v2, v2))&#xA;    Next&#xA;Next&#xA;&#xA;' Step 4: Simple threshold (global - mean-based). This binarizes to pure black/white.&#xA;Dim total As Long = 0&#xA;For y As Integer = 0 To bmpResized.Height - 1&#xA;    For x As Integer = 0 To bmpResized.Width - 1&#xA;        total += bmpResized.GetPixel(x, y).R&#xA;    Next&#xA;Next&#xA;Dim mean As Integer = CInt(total / (bmpResized.Width * bmpResized.Height))&#xA;&#xA;For y As Integer = 0 To bmpResized.Height - 1&#xA;    For x As Integer = 0 To bmpResized.Width - 1&#xA;        Dim v As Integer = bmpResized.GetPixel(x, y).R&#xA;        If v &gt;= mean Then&#xA;            bmpResized.SetPixel(x, y, System.Drawing.Color.FromArgb(255, 255, 255))&#xA;        Else&#xA;            bmpResized.SetPixel(x, y, System.Drawing.Color.FromArgb(0, 0, 0))&#xA;        End If&#xA;    Next&#xA;Next&#xA;&#xA;' Save processed image&#xA;bmpResized.Save(outPath, System.Drawing.Imaging.ImageFormat.Png)&#xA;bmpResized.Dispose()&#xA;&#xA;out_filepath = outPath&#xA;" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
